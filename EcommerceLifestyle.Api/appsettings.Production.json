{
  // ─────────────────────────────────────────────────────────────────────
  //  appsettings.Production.json -- DEPLOYED "main" branch only.
  //
  //  Loaded ON TOP of appsettings.json when ASPNETCORE_ENVIRONMENT=Production.
  //  Only the keys present here override the base file.
  //
  //  Activate on Railway:  Service -> Variables -> add
  //      ASPNETCORE_ENVIRONMENT = Production
  //  on the Railway service that auto-deploys the `main` branch.
  //  (Production is the .NET default when ASPNETCORE_ENVIRONMENT is unset,
  //  so setting it explicitly is optional but recommended for clarity.)
  // ─────────────────────────────────────────────────────────────────────
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // Production database connection string. If a separate prod DB exists,
    // point this at it; otherwise reuse the same internal Railway MySQL.
    "Default": "Server=mysql.railway.internal;Port=3306;Database=railway;User=root;Password=REPLACE_WITH_PROD_DB_PASSWORD;TreatTinyAsBoolean=true"
  },
  "Jwt": {
    // Use a DIFFERENT signing key in production -- compromising the dev key
    // must never let an attacker forge prod tokens.
    "Key": "REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PROD_KEY_AT_LEAST_32_CHARS"
  },
  "Oidc": {
    // Google / GitHub OAuth apps registered for the production frontend URL.
    // Authorized redirect URIs:
    "Google": {
      "ClientId": "REPLACE_WITH_PROD_GOOGLE_CLIENT_ID",
      "ClientSecret": "REPLACE_WITH_PROD_GOOGLE_CLIENT_SECRET"
    },
    "GitHub": {
      "ClientId": "REPLACE_WITH_PROD_GITHUB_CLIENT_ID",
      "ClientSecret": "REPLACE_WITH_PROD_GITHUB_CLIENT_SECRET"
    }
  }
}
