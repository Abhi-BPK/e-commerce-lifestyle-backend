{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "dotnet publish EcommerceLifestyle.Api/EcommerceLifestyle.Api.csproj -c Release -o /app/publish"
  },
  "deploy": {
    "startCommand": "dotnet /app/publish/EcommerceLifestyle.Api.dll",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
